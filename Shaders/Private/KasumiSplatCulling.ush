[numthreads(64, 1, 1)]
void InitializeClusterDispatchCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint WorkgroupIndex = DispatchThreadId.x;
    if (WorkgroupIndex < SourceWorkgroupCount)
    {
        RWVisibleClusterWorkgroups[WorkgroupIndex] = WorkgroupIndex;
    }
    if (WorkgroupIndex == 0u)
    {
        RWClusterDispatchArgs[0] = 0u;
        RWClusterDispatchArgs[1] = 1u;
        RWClusterDispatchArgs[2] = 1u;
        RWClusterCullFallback[0] = 0u;
    }
}

[numthreads(64, 1, 1)]
void ClusterCullCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint ClusterIndex = DispatchThreadId.x;
    if (ClusterIndex >= ClusterCount)
    {
        return;
    }

    const float4 Bounds = ClusterBounds[ClusterIndex];
    const float Radius = max(Bounds.w * max(RadiusScale, 0.0) + max(RadiusInflation, 0.0), 0.0);
    const float4 CenterClip = mul(mul(float4(Bounds.xyz, 1.0), LocalToWorld), WorldToClip);
    const float4 AxisX = mul(mul(float4(Radius, 0.0, 0.0, 0.0), LocalToWorld), WorldToClip);
    const float4 AxisY = mul(mul(float4(0.0, Radius, 0.0, 0.0), LocalToWorld), WorldToClip);
    const float4 AxisZ = mul(mul(float4(0.0, 0.0, Radius, 0.0), LocalToWorld), WorldToClip);
    const float4 ExtentClip = abs(AxisX) + abs(AxisY) + abs(AxisZ);
    const float PlaneExtentX = ExtentClip.x + ExtentClip.w;
    const float PlaneExtentY = ExtentClip.y + ExtentClip.w;
    const float PlaneExtentZ = ExtentClip.z + ExtentClip.w;
    bool bVisible =
        CenterClip.w + ExtentClip.w > 0.01 &&
        CenterClip.x + CenterClip.w + PlaneExtentX >= 0.0 &&
        CenterClip.w - CenterClip.x + PlaneExtentX >= 0.0 &&
        CenterClip.y + CenterClip.w + PlaneExtentY >= 0.0 &&
        CenterClip.w - CenterClip.y + PlaneExtentY >= 0.0 &&
        CenterClip.z + ExtentClip.z >= 0.0 &&
        CenterClip.w - CenterClip.z + PlaneExtentZ >= 0.0;

    const float MinimumW = CenterClip.w - ExtentClip.w;
    if (bVisible && MinProjectedRadiusPixels > 0.0 && MinimumW > 0.01)
    {
        const float2 Numerator =
            ExtentClip.xy * abs(CenterClip.w) + abs(CenterClip.xy) * ExtentClip.w;
        const float2 NdcRadius = Numerator / max(abs(CenterClip.w) * MinimumW, 1.0e-6);
        const float ProjectedRadius = max(NdcRadius.x * ViewSize.x, NdcRadius.y * ViewSize.y) * 0.5;
        bVisible = ProjectedRadius >= MinProjectedRadiusPixels;
    }
    RWClusterVisibility[ClusterIndex] = bVisible ? 1u : 0u;
    if (bVisible && BuildIndirectWorkgroups != 0u)
    {
        const uint FirstPoint = ClusterIndex * ClusterPointCount;
        const uint ClusterSourcePointCount = min(ClusterPointCount, SourcePointCount - FirstPoint);
        const uint FirstWorkgroup = FirstPoint / 64u;
        const uint WorkgroupCount = (ClusterSourcePointCount + 63u) / 64u;
        uint OutputOffset;
        InterlockedAdd(RWClusterDispatchArgs[0], WorkgroupCount, OutputOffset);
        [loop]
        for (uint WorkgroupOffset = 0u; WorkgroupOffset < WorkgroupCount; ++WorkgroupOffset)
        {
            RWVisibleClusterWorkgroups[OutputOffset + WorkgroupOffset] = FirstWorkgroup + WorkgroupOffset;
        }
    }
}

[numthreads(1, 1, 1)]
void FinalizeClusterDispatchCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    if (RWClusterDispatchArgs[0] == 0u)
    {
        // A conservative full dispatch prevents a transient all-cluster rejection from
        // suppressing the per-point visibility pass for the entire frame.
        RWClusterDispatchArgs[0] = SourceWorkgroupCount;
        RWClusterCullFallback[0] = 1u;
    }
}

[numthreads(64, 1, 1)]
void CullCS(
    uint3 DispatchThreadId : SV_DispatchThreadID,
    uint3 GroupId : SV_GroupID,
    uint3 GroupThreadId : SV_GroupThreadID)
{
    const uint SampleIndex = UseCompactedClusterDispatch != 0u
        ? VisibleClusterWorkgroups[GroupId.x] * 64u + GroupThreadId.x
        : DispatchThreadId.x;
    if (SampleIndex >= PointCount)
    {
        return;
    }
    const uint BaseCount = SourcePointCount / PointCount;
    const uint Remainder = SourcePointCount % PointCount;
    const uint GroupStart = SampleIndex * BaseCount + min(SampleIndex, Remainder);
    const uint GroupCount = BaseCount + (SampleIndex < Remainder ? 1u : 0u);
    const uint OutputIndex = GroupOutputBase + SampleIndex;
    if (UseClusterCulling != 0u && ClusterCount > 0u && ClusterCullFallback[0] == 0u)
    {
        const uint FirstCluster = min(GroupStart / ClusterPointCount, ClusterCount - 1u);
        const uint LastCluster = min((GroupStart + GroupCount - 1u) / ClusterPointCount, ClusterCount - 1u);
        bool bAnyClusterVisible = false;
        [loop]
        for (uint ClusterIndex = FirstCluster; ClusterIndex <= LastCluster; ++ClusterIndex)
        {
            bAnyClusterVisible = bAnyClusterVisible || ClusterVisibility[ClusterIndex] != 0u;
        }
        if (!bAnyClusterVisible)
        {
            if (SortPath == 0u)
            {
                RWVisibilityBuckets[SampleIndex] = KASUMI_INVALID_BUCKET;
                RWExactValues[SampleIndex] = GroupStart;
            }
            else if (SortPath == 1u || EnableTiledFallback != 0u)
            {
                RWExactKeys[OutputIndex] = 0xffffffffu;
                RWExactValues[OutputIndex] = 0xffffffffu;
            }
            return;
        }
    }
    uint PointIndex = GroupStart;
    float BestImportance = -3.402823466e+38;
    float4 CenterClip = 0.0;
    float4 Rotation = 0.0;
    float4 SigmaAndAlpha = 0.0;
    uint StableId = 0u;
    float Weight = 0.0;
    float LayerScale = 1.0;
    float4 LayerColor = 1.0;
    float3 TransformedLocalPosition = 0.0;
    float3 Covariance = 0.0;
    float EffectiveAlpha = 0.0;
    [loop]
    for (uint CandidateOffset = 0u; CandidateOffset < GroupCount; ++CandidateOffset)
    {
        const uint CandidateIndex = GroupStart + CandidateOffset;
        float4 CandidateCenterClip;
        float4 CandidateRotation;
        float4 CandidateSigmaAndAlpha;
        uint CandidateStableId;
        float CandidateWeight;
        float CandidateLayerScale;
        float4 CandidateLayerColor;
        float3 CandidateLocalPosition;
        LoadTransformedPoint(
            CandidateIndex,
            CandidateCenterClip,
            CandidateRotation,
            CandidateSigmaAndAlpha,
            CandidateStableId,
            CandidateWeight,
            CandidateLayerScale,
            CandidateLayerColor,
            CandidateLocalPosition);
        const float4 CandidateFilteredCovariance = ComputeCovariance(
            CandidateCenterClip,
            CandidateRotation,
            CandidateSigmaAndAlpha,
            CandidateWeight,
            CandidateLayerScale);
        const float3 CandidateCovariance = CandidateFilteredCovariance.xyz;
        const float CandidateDeterminant =
            CandidateCovariance.x * CandidateCovariance.z - CandidateCovariance.y * CandidateCovariance.y;
        const float2 CandidateNdc = CandidateCenterClip.xy / max(CandidateCenterClip.w, 1.0e-6);
        const bool bCandidateProjectable = CandidateCenterClip.w > 0.01 &&
            CandidateCenterClip.z >= 0.0 && CandidateCenterClip.z <= CandidateCenterClip.w &&
            CandidateDeterminant > 1.0e-8 &&
            abs(CandidateNdc.x) <= 1.25 && abs(CandidateNdc.y) <= 1.25;
        const float CandidateEffectAlpha = lerp(1.0, EffectTint.a, CandidateWeight);
        const float CandidateEffectOpacity = lerp(1.0, EffectValues.y, CandidateWeight);
        const float CandidateEffectiveAlpha = saturate(
            ApplyOpacityDensity(CandidateSigmaAndAlpha.w) *
            TransitionOpacity(CandidateIndex) *
            max(StyleValues.y, 0.0) *
            max(Tint.a, 0.0) *
            max(CandidateEffectAlpha, 0.0) *
            max(CandidateEffectOpacity, 0.0) *
            max(CandidateLayerColor.a, 0.0) *
            max(CandidateFilteredCovariance.w, 0.0));
        const float Importance = bCandidateProjectable
            ? CandidateEffectiveAlpha * sqrt(max(CandidateDeterminant, 0.0))
            : -1.0;
        if (Importance > BestImportance ||
            (Importance == BestImportance && CandidateStableId < StableId))
        {
            BestImportance = Importance;
            PointIndex = CandidateIndex;
            CenterClip = CandidateCenterClip;
            Rotation = CandidateRotation;
            SigmaAndAlpha = CandidateSigmaAndAlpha;
            StableId = CandidateStableId;
            Weight = CandidateWeight;
            LayerScale = CandidateLayerScale;
            LayerColor = CandidateLayerColor;
            TransformedLocalPosition = CandidateLocalPosition;
            Covariance = CandidateCovariance;
            EffectiveAlpha = CandidateEffectiveAlpha;
        }
    }

    const float Determinant = Covariance.x * Covariance.z - Covariance.y * Covariance.y;
    const float RadiusX = min(3.0 * sqrt(max(Covariance.x, 0.0)), ProjectedRadiusRange.y);
    const float RadiusY = min(3.0 * sqrt(max(Covariance.z, 0.0)), ProjectedRadiusRange.y);
    const float MaxRadius = max(RadiusX, RadiusY);
    const float2 Ndc = CenterClip.xy / max(CenterClip.w, 1.0e-6);
    const float2 NdcRadius = 2.0 * float2(RadiusX, RadiusY) / ViewSize;
    const float DeviceZ = CenterClip.z / max(CenterClip.w, 1.0e-6);
    const float2 RelativePixel = (Ndc * float2(0.5, -0.5) + 0.5) * ViewSize;
    const int2 ScenePixel = int2(ViewRectMin + clamp(RelativePixel, 0.0.xx, ViewSize - 1.0.xx));
    const float SceneDeviceZAtCenter = SceneTexturesStruct.SceneDepthTexture.Load(int3(ScenePixel, 0)).r;
    const bool bCenterOccluded =
        UseSceneDepth != 0u &&
        DepthPreCullMaxRadiusPixels > 0.0 &&
        MaxRadius <= DepthPreCullMaxRadiusPixels &&
        SceneDeviceZAtCenter > DeviceZ + SceneDepthBias;
    const bool bVisible =
        CenterClip.w > 0.01 &&
        CenterClip.z >= 0.0 && CenterClip.z <= CenterClip.w &&
        Determinant > 1.0e-8 &&
        EffectiveAlpha >= KASUMI_MIN_EFFECTIVE_ALPHA &&
        MaxRadius >= ProjectedRadiusRange.x &&
        abs(Ndc.x) <= 1.0 + NdcRadius.x &&
        abs(Ndc.y) <= 1.0 + NdcRadius.y &&
        !bCenterOccluded;

    uint Bucket = KASUMI_INVALID_BUCKET;
    uint ExactKey = 0xffffffffu;
    if (bVisible)
    {
        const float LogDepthBucket = 1.0 - saturate(log2(max(CenterClip.w, 1.0)) / 20.0);
        const float SortDepth = UseLogDepthSort != 0u ? LogDepthBucket : saturate(DeviceZ);
        Bucket = min(uint(SortDepth * float(KASUMI_BUCKET_COUNT - 1u)), KASUMI_BUCKET_COUNT - 1u);
        ExactKey = UseLogDepthSort != 0u ? ~asuint(max(CenterClip.w, 0.0)) : asuint(saturate(DeviceZ));
        if (SortPath == 0u)
        {
            InterlockedAdd(RWBucketCounts[Bucket], 1u);
        }
        else if (SortPath == 1u || EnableTiledFallback != 0u)
        {
            InterlockedAdd(RWDrawIndirectArgs[1], 1u);
        }
        if (SortPath == 2u)
        {
            const int2 TileCount = int2(TileConfig.yz);
            const float TileSize = float(TileConfig.x);
            int2 TileMin = clamp(int2(floor((RelativePixel - float2(RadiusX, RadiusY)) / TileSize)), 0, TileCount - 1);
            int2 TileMax = clamp(int2(floor((RelativePixel + float2(RadiusX, RadiusY)) / TileSize)), 0, TileCount - 1);
            int2 TileSpan = TileMax - TileMin + 1;
            const uint TileOverlapCount = uint(TileSpan.x * TileSpan.y);
            if (TileOverlapCount <= MaxTilesPerSplat)
            {
                const uint DepthShift = 32u - TileDepthBits;
                const uint DepthMask = 0xffffffffu >> DepthShift;
                const float2 ClipWGradient = ComputeClipWGradient(
                    CenterClip, Rotation, SigmaAndAlpha, Weight, LayerScale);
                [loop]
                for (int TileY = TileMin.y; TileY <= TileMax.y; ++TileY)
                {
                    [loop]
                    for (int TileX = TileMin.x; TileX <= TileMax.x; ++TileX)
                    {
                        const uint TileIndex = uint(TileY) * TileConfig.y + uint(TileX);
                        const float2 TileCenterPixel = (float2(TileX, TileY) + 0.5) * TileSize;
                        const float LocalClipW = max(CenterClip.w + dot(
                            ClipWGradient,
                            TileCenterPixel - RelativePixel), 1.0);
                        const float LogarithmicDepth = 1.0 - saturate(log2(LocalClipW) / 20.0);
                        const uint QuantizedDepth = uint(LogarithmicDepth * float(DepthMask));
                        uint PairIndex;
                        InterlockedAdd(RWTileDrawIndirectArgs[1], 1u, PairIndex);
                        if (PairIndex < TilePairCapacity)
                        {
                            RWTileKeys[PairIndex] = (TileIndex << TileDepthBits) | QuantizedDepth;
                            RWTileValues[PairIndex] = PointIndex;
                        }
                        else
                        {
                            InterlockedAdd(RWTileOverflow[0], 1u);
                        }
                    }
                }
            }
            else
            {
                InterlockedAdd(RWTileOverflow[0], 1u);
            }
        }
    }
    if (WriteGroupRecords != 0u && bVisible)
    {
        float4 SourceColor = LoadSourceColor(PointIndex);
        SourceColor.rgb = ApplyAppearanceColor(EvaluateHigherOrderSH(
            PointIndex,
            SourceColor.rgb,
            normalize(mul(
                float4(normalize(TransformedLocalPosition - ViewLocalPosition + float3(1.0e-6, 0.0, 0.0)), 0.0),
                LocalToSHDirection).xyz)));
        const float3 EffectColor = lerp(1.0.xxx, EffectTint.rgb, Weight);
        const float3 FinalColor =
            SourceColor.rgb * Tint.rgb * EffectColor * LayerColor.rgb * View.PreExposure;
        const float3 CurrentWorldPosition = mul(float4(TransformedLocalPosition, 1.0), LocalToWorld).xyz;
        const float4 CurrentVelocityClip = mul(
            float4(CurrentWorldPosition + DFHackToFloat(ResolvedView.PreViewTranslation), 1.0),
            ResolvedView.TranslatedWorldToClip);
        const float3 PreviousWorldPosition = mul(
            float4(TransformedLocalPosition, 1.0),
            PreviousLocalToWorld).xyz;
        const float4 PreviousVelocityClip = ResetVelocityHistory != 0u
            ? CurrentVelocityClip
            : mul(
                float4(PreviousWorldPosition + DFHackToFloat(ResolvedView.PrevPreViewTranslation), 1.0),
                ResolvedView.PrevTranslatedWorldToClip);
        const uint RecordBase = OutputIndex * 6u;
        RWGroupRecordData[RecordBase + 0u] = CenterClip;
        RWGroupRecordData[RecordBase + 1u] = float4(Covariance, ComputeDeviceDepthRadius(
            CenterClip, Rotation, SigmaAndAlpha, Weight, LayerScale));
        RWGroupRecordData[RecordBase + 2u] = float4(FinalColor, EffectiveAlpha);
        RWGroupRecordData[RecordBase + 3u] = CurrentVelocityClip;
        RWGroupRecordData[RecordBase + 4u] = PreviousVelocityClip;
        RWGroupRecordData[RecordBase + 5u] = float4(
            ProjectedRadiusRange.y,
            SceneDepthBias,
            float(UseSceneDepth),
            float(VelocityEnabled));
    }
    if (SortPath == 0u)
    {
        RWVisibilityBuckets[SampleIndex] = Bucket;
        RWExactValues[SampleIndex] = PointIndex;
    }
    else if (SortPath == 1u || EnableTiledFallback != 0u)
    {
        RWExactKeys[OutputIndex] = ExactKey;
        RWExactValues[OutputIndex] = WriteGroupRecords != 0u ? OutputIndex : PointIndex;
    }
}

[numthreads(1, 1, 1)]
void FinalizeTiledCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const bool bOverflow = RWTileOverflow[0] != 0u || RWTileDrawIndirectArgs[1] > TilePairCapacity;
    RWDrawIndirectArgs[0] = 6u;
    RWDrawIndirectArgs[2] = 0u;
    RWDrawIndirectArgs[3] = 0u;
    RWTileDrawIndirectArgs[0] = 6u;
    RWTileDrawIndirectArgs[2] = 0u;
    RWTileDrawIndirectArgs[3] = 0u;
    if (bOverflow)
    {
        RWTileDrawIndirectArgs[1] = 0u;
    }
    else
    {
        RWDrawIndirectArgs[1] = 0u;
    }
}

[numthreads(1, 1, 1)]
void PrefixCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint VisibleCount = 0u;
    [loop]
    for (uint Bucket = 0u; Bucket < KASUMI_BUCKET_COUNT; ++Bucket)
    {
        RWBucketOffsets[Bucket] = VisibleCount;
        RWBucketWriteOffsets[Bucket] = VisibleCount;
        VisibleCount += BucketCounts[Bucket];
    }

    RWDrawIndirectArgs[0] = 6u;
    RWDrawIndirectArgs[1] = VisibleCount;
    RWDrawIndirectArgs[2] = 0u;
    RWDrawIndirectArgs[3] = 0u;
}

[numthreads(64, 1, 1)]
void ScatterCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint SampleIndex = DispatchThreadId.x;
    if (SampleIndex < PointCount)
    {
        const uint Bucket = VisibilityBuckets[SampleIndex];
        if (Bucket != KASUMI_INVALID_BUCKET)
        {
            uint OutputIndex;
            InterlockedAdd(RWBucketWriteOffsets[Bucket], 1u, OutputIndex);
            RWSortedIndices[OutputIndex] = ExactValues[SampleIndex];
        }
    }
}

struct FKasumiVertexOutput
{
    float4 Position : SV_POSITION;
    noperspective float2 DeltaPixels : TEXCOORD0;
    nointerpolation float3 Conic : TEXCOORD1;
    nointerpolation float4 Color : COLOR0;
    nointerpolation uint TileIndex : TEXCOORD2;
    nointerpolation float DepthRadius : TEXCOORD3;
    nointerpolation float4 CurrentCenterClip : TEXCOORD4;
    nointerpolation float4 PreviousCenterClip : TEXCOORD5;
    nointerpolation float4 ComponentSettings : TEXCOORD6;
};
